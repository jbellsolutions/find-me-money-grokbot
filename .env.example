# Names only. Real values go in /workspace/find-me-money/.secrets/fmm.env (mode 600) by hidden prompt or a secure secret card.
# Role in brackets. Never commit a value. Any key ever pasted in a chat is rotated first.
FMM_HOME=/workspace/find-me-money/state
REPLY_HOME=/workspace/find-me-money/pinnacle-reply
# [lead] Slack and Notion: the bot's own channel and pages
SLACK_BOT_TOKEN=
NOTION_TOKEN=
# [radar, wholesale] the Funding Radar (read first; import only when funding-radar: bot)
RADAR_URL=
RADAR_PASSWORD=
RADAR_IMPORT_URL=
RADAR_IMPORT_TOKEN=
# [radar] treg, One API, Scrapebox, browser-box
TREG_API_KEY=
ONE_API_URL=
ONE_API_TOKEN=
SCRAPEBOX_URL=
SCRAPEBOX_TOKEN=
BROWSER_BOX_URL=
BROWSER_BOX_TOKEN=
# [muse] Orgo, for Muse only: MUSE_COMPUTER is the one computer it drives
ORGO_API_KEY=
MUSE_COMPUTER=
# [sales] Pinnacle Funding Group in GoHighLevel (read-only key first), the Reply Agent's drafter
GHL_API_KEY=
GHL_LOCATION_ID=
ANTHROPIC_API_KEY=
# [sales] Reply Agent switches: leave off until Justin says so
REPLY_WRITE=
REPLY_GHL=
REPLY_GHL_TARGET=
# [sales, partners, loan-officer] the Lending Hub
HUB_URL=
HUB_PASSWORD=
# [outreach] Instantly (read-only key first), the Reacher email verifier
INSTANTLY_API_KEY=
REACHER_URL=
# [all] Intake values: not secrets, but private, so never in the pack. Justin pastes them at intake (NEEDS-JUSTIN row 6).
# The never-touch names (computers, agents, accounts never used, not even read). Comma-separated, or one per line in
# .secrets/never-touch.txt. Missing: preflight, owner_guard.py, orgo.py and muse.py refuse every guarded write.
NEVER_TOUCH=
# Hosts of the live services the jobs reach (the Radar, the Lending Hub), comma-separated. Missing: preflight refuses.
FMM_HOSTS=
# [sales] The home CRM's location id (Pinnacle Funding Group); config/*.json read it as <PINNACLE_GHL_LOCATION_ID>
PINNACLE_GHL_LOCATION_ID=
# [sales] The other funding location, never written (read-only inbox and calendar), and its booking calendar ids
FM_GHL_LOCATION_ID=
FM_GHL_CALENDARS=
# [sales] Sub-account names the Reply Agent never writes to, comma-separated
REPLY_NEVER_LOCATIONS=
# [sales] Names a message never says (the legal entity, the broker of record), comma-separated
FCM_NEVER_SAY=
# [sales] The four GHL workflow ids in engine/fcm/config/lead-workflows.json
FMG_NURTURE_WORKFLOW_ID=
FMG_REACTIVATION_WORKFLOW_ID=
FMG_SALES_CONTENT_WORKFLOW_ID=
FMG_NEWSLETTER_WORKFLOW_ID=
# [sales] The GHL agency (company) id, for the gohighlevel-cli skill's agency commands
GHL_COMPANY_ID=
# [radar] The One API hub page (skill page and downloads)
ONE_API_HUB_URL=
# [outreach] The Instantly tag id on the Winnr mailboxes
INSTANTLY_WINNR_TAG_ID=
# [sales] gohighlevel-cli skill only: the install folder
GHL_MCP_HOME=
# [fcm] The owner's Super Browser MCP URL (fcm only)
SUPER_BROWSER_URL=
# [sales] Optional: the Hermes Python that build_profiles.py uses
HERMES_PYTHON=
# [loan-officer, sales] The fulfillment partner's short id, as the CRM stage "Submitted · <id>" and tag route:<id> name it
FULFILLMENT_PARTNER=
FMM_MAILING_ADDRESS=
