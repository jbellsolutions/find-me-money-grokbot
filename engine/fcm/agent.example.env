# Funding CRM Manager — copy to ~/.fcm/agent.env on the agent's computer (chmod 600). NEVER commit real values.

# ── Model ───────────────────────────────────────────────────────────
# The agent runs on claude-haiku-5-5, set in profiles/funding-crm-manager/config.template.yaml.
ANTHROPIC_API_KEY=
# Optional drafting outside the agent loop (fcm.llm). Blank = templates and keyword rules, no model calls.
OPENROUTER_API_KEY=
FCM_DRAFT_MODEL=
FCM_FALLBACK_MODEL=

# ── GoHighLevel: the DEMO location only (Private Integration Token, pit-...) ──
# Keep FCM_GHL_MODE=mock until the demo sub-account + PIT exist, then switch to live and run `fcm ghl bootstrap --apply`.
FCM_GHL_MODE=mock
FCM_DEMO_MODE=1            # 1 = only contacts tagged fcm:test-contact receive real messages
GHL_API_KEY=
GHL_LOCATION_ID=
PINNACLE_GHL_LOCATION_ID=  # the home CRM's location id: config/*.json read it as <PINNACLE_GHL_LOCATION_ID>
FM_GHL_LOCATION_ID=        # the other funding location, never written
FCM_NEVER_SAY=             # comma-separated names a message never says (legal entity, broker of record)
FCM_MANAGER_USER_NAME=     # GHL user who gets follow-up tasks (partial name match)

# ── CRM: GoHighLevel (default) or Attio ─────────────────────────────
FCM_CRM=ghl                # attio = partner records in Attio; texts go out through FCM_CHANNEL
ATTIO_API_KEY=             # Attio workspace token: record, note, task, list_entry, list_configuration, object_configuration
FCM_CHANNEL=               # with Attio: relay (your own phones, via deploy/phone-bridge) or twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=   # or TWILIO_FROM_NUMBER
TWILIO_FROM_NUMBER=
FCM_DEMO_SLACK_CHANNEL=    # live demo feed channel (default SLACK_HOME_CHANNEL)

# ── Recorded calls: any recorder's transcript export (JSON / VTT / TXT) dropped here is ingested ──
FCM_CALL_INBOX=            # default ~/fcm-inbox/calls

# ── The agent's own Orgo computer (workspace-scoped key) ────────────
ORGO_API_KEY=
ORGO_COMPUTER_ID=
ORGO_MCP_VERSION=1.1.1

# ── Browsers (skills, not the focus) ────────────────────────────────
# browser-box reads pages; data-box turns pages into data. Self-host both (the owner has the kit).
BROWSER_BOX_URL=           # https://your-box/mcp (the bare base URL works too)
BROWSER_BOX_TOKEN=
DATABOX_URL=               # https://your-data-box/mcp (or the base URL)
DATABOX_TOKEN=
# Super Browser (being retired): only for bulk lead lists and approval-gated writes
SUPER_BROWSER_URL=         # the owner's Super Browser MCP URL (set at intake)
SUPER_BROWSER_TOKEN=

# ── Manager channel: Slack app (socket mode) ────────────────────────
SLACK_BOT_TOKEN=           # xoxb-...
SLACK_APP_TOKEN=           # xapp-... (connections:write)
SLACK_HOME_CHANNEL=        # channel ID of the bot's own channel
SLACK_ALLOWED_USERS=       # comma-separated Slack member IDs allowed to talk to / approve for the agent

# ── Obsidian vault sync (private repo) ──────────────────────────────
VAULT_GIT_REMOTE=          # e.g. git@github.com:<owner>/<private-vault-repo>.git

# ── Leads and handoffs ───────────────────────────────────────────────────────────────────────────────────────────
HUB_URL=                   # the Lending Hub base URL, set at intake
HUB_PASSWORD=
FCM_VAULT_NAME=Funding CRM Manager
# Intros, partner nudges and lead check-ins stay held until this is 1. Justin's switch.
FCM_SEND_HANDOFFS=0

# ── Campaign replies ─────────────────────────────────────────────────────────────────────────────────────────────
# The account holds other businesses' campaigns: the agent reads only the campaign ids listed here.
INSTANTLY_API_KEY=
FCM_INSTANTLY_CAMPAIGNS=
# Answers to leads stay held until this is 1. Justin's switch.
FCM_SEND_REPLIES=0
# Tells the sender who said stop. Turn this on before the first cold send.
FCM_SYNC_OPT_OUTS=0
# Collections messages to partners stay held drafts until this is 1. Justin's switch.
FCM_SEND_COLLECTIONS=0
