  "reach": ["email", "linkedin_url", "x_url", "instagram_url", "community_url"],
  "optional": ["first_name", "brand", "platform", "topic", "group_name", "site", "source_list", "audience_source"]
 },
 "fill": {
  "what_we_do": "one plain line on what the business does and for whom",
